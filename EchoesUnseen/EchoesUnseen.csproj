<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Stamp the build time into the assembly. Twice now a report has been analysed
         against source that was not in the exe that produced it, and there was no way
         to tell from the log. A timestamp settles it in one line. -->
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmm"))</SourceRevisionId>
    <!-- Publish the end-user build with  -p:Distribution=true  to show the
         "Send feedback / crash report" button (hidden in the dev build). -->
    <DefineConstants Condition="'$(Distribution)'=='true'">$(DefineConstants);DISTRIBUTION</DefineConstants>
    <RootNamespace>EchoesUnseen</RootNamespace>
    <AssemblyName>EchoesUnseen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Self-contained publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- App metadata -->
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <!-- Beta line. The old "21.x" numbering belonged to the pre-rebuild WPF
         builds; this native rebuild ships as Beta 1.x so tester reports and the
         About tab agree. -->
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Company>Echoes Unseen</Company>
    <Product>Echoes Unseen</Product>
    <Description>Accessibility overlay companion for Guild Wars 2</Description>
  </PropertyGroup>

  <!-- The feedback channel's webhook URL is a SECRET and is never committed. Supply it
       only when publishing a build that should post reports:
         dotnet publish ... -p:DiscordWebhook=https://discord.com/api/webhooks/...
       On a dev machine, drop the URL into %APPDATA%\EchoesUnseen\discord-webhook.txt
       instead. With neither, the Send button simply says no channel is configured. -->
  <ItemGroup Condition="'$(DiscordWebhook)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DiscordWebhook</_Parameter1>
      <_Parameter2>$(DiscordWebhook)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Audio capture (microphone) and tone generation (sonar) -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- MVVM plumbing: ObservableObject, RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Windows SAPI for TTS + System.Speech.Recognition for local
         speech-to-text (the OS accessibility feature, NOT AI/ML —
         it's a 1990s Hidden Markov Model that ships with Windows). -->
    <PackageReference Include="System.Speech" Version="8.0.0" />

    <!-- GDI/Bitmap support for screen capture (needed by OCR panels) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Optional higher-accuracy OCR engine (offline). eng.traineddata is
         downloaded on first use, like the voices. The native libs are ALSO embedded
         (below) and extracted at runtime, so the single .exe is self-contained. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- RapidOCR: PP-OCRv5 mobile models through ONNX Runtime, Apache-2.0, entirely
         offline. Chosen on measured evidence against real Guild Wars 2 hover captures,
         where it found half again as many lines as Windows OCR with the lowest junk rate
         of the three engines tried. The models themselves are
         embedded below rather than left beside the binary, because there is no "beside"
         in a single-file exe. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

  <!-- OpenCV + RapidOCR hover targeting. The decisions live in Services/Hover/Fusion and are
       judged by tools/HoverReplay against the recorded corpus before any change is heard.
       In the app it is a setting (Enhanced Hover Targeting), on by default since b1.5.
       OpenCV's OFFICIAL SLIM runtime: core, imgproc, imgcodecs and a few geometry modules;
       no FFmpeg (so nothing LGPL), no video, no GUI, no DNN. Apache-2.0. -->
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- The RapidOcrNet package copies its models next to the binary. We carry them
       INSIDE the exe instead (see the EmbeddedResource entries below), so the loose
       copies would be 13.7 MB of duplicate sitting beside a single-file app that is
       supposed to be one file. -->
  <Target Name="DropLooseRapidOcrModels" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)models" />
  </Target>

  <!-- Static assets (Piper voice binaries + models, songs library, optional app icon) -->
  <ItemGroup>
    <None Include="Resources\Piper\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Embedded so a single-file exe carries the starter songs with no loose
         Songs folder; also copied to output for normal folder builds. -->
    <EmbeddedResource Include="Songs\bundled-songs.json" />
    <!-- Tesseract native libs embedded so the single-file exe can extract them at
         runtime (the package otherwise ships them as loose x64/ files). -->
    <EmbeddedResource Include="Resources\TessNative\leptonica-1.82.0.dll" />
    <EmbeddedResource Include="Resources\TessNative\tesseract50.dll" />
    <EmbeddedResource Include="Resources\Nvda\nvdaControllerClient64.dll" />
    <!-- PP-OCRv5 latin models (13.7 MB), embedded for the same reason as the Tesseract
         natives above: the NuGet copies them next to the binary, and a single-file exe
         has no next-to. Extracted once to AppData on first hover. -->
    <EmbeddedResource Include="Resources\RapidOcr\ch_PP-OCRv5_mobile_det.onnx" />
    <EmbeddedResource Include="Resources\RapidOcr\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" />
    <EmbeddedResource Include="Resources\RapidOcr\latin_PP-OCRv5_rec_mobile_infer.onnx" />
    <EmbeddedResource Include="Resources\RapidOcr\ppocrv5_latin_dict.txt" />
    <EmbeddedResource Include="Resources\Ahk\AutoHotkey64.exe" />
    <None Include="Songs\bundled-songs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ensure icon is present at build time (if it exists) -->
    <None Update="Resources\app.ico" Condition="Exists('Resources\app.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- HUD ring artwork and any other in-app images. Embedded into the assembly
       so XAML can reference them via pack URIs without needing the files on disk. -->
  <ItemGroup>
    <Resource Include="Resources\Images\**\*.png" />
    <Resource Include="Resources\Images\**\*.jpg" />
  </ItemGroup>

</Project>
