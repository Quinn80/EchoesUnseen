<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════════
         COLOR PALETTE — default "Hot Pink" theme values.
         These are the initial values; ThemeService replaces them at runtime
         when the user picks a different theme in Settings.
         ══════════════════════════════════════════════════════════════════ -->

    <Color x:Key="PrimaryColor">#FFFF1A8A</Color>
    <Color x:Key="PrimaryColorGlow">#66FF1A8A</Color>
    <Color x:Key="SecondaryColor">#FFA41435</Color>
    <Color x:Key="BackgroundColor">#FF0A0A0F</Color>
    <Color x:Key="SurfaceColor">#CC14141C</Color>
    <Color x:Key="SurfaceBorderColor">#FFFF1A8A</Color>
    <Color x:Key="ForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="MutedColor">#FFB8B8C8</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>
    <Color x:Key="WarningColor">#FFFACC15</Color>
    <Color x:Key="ErrorColor">#FFEF4444</Color>

    <!-- ═══════════════════════════════════════════════════════════════════
         v21 GLOBAL TEXT SIZE — one body size drives all panel text via
         DynamicResource + WPF font inheritance. "Small" is for hints and
         captions and tracks the body size (ThemeService keeps it in step).
         ══════════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="GlobalFontSize">22</sys:Double>
    <sys:Double x:Key="GlobalFontSizeSmall">12</sys:Double>

    <!-- v21 FOCUS VISUAL — replaces WPF's faint dotted focus rectangle with a
         solid, clearly visible outline everywhere. High Contrast switches
         FocusBrush to pure white. -->
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFF1A8A"/>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               StrokeThickness="2.5"
                               Stroke="{DynamicResource FocusBrush}"
                               RadiusX="4" RadiusY="4"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v21 PANEL CHROME — the pop-up frame's border, card and title brushes,
         extracted from PanelHost so High Contrast can restyle them live.
         Defaults match the Claude Design look exactly. -->
    <LinearGradientBrush x:Key="PanelFiligreeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6C7AE5" Offset="0.0"/>
        <GradientStop Color="#FF1B275F" Offset="0.35"/>
        <GradientStop Color="#FFE472DC" Offset="0.65"/>
        <GradientStop Color="#FF122555" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF02030C" Offset="0.0"/>
        <GradientStop Color="#FF010105" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelTitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF47C9FF" Offset="0.0"/>
        <GradientStop Color="#FFFF94FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════════
         v21.4 TAB STYLING — WPF's default tab headers are light-on-light
         (the selected tab was a white chip with white text: unreadable).
         These implicit styles restyle every TabControl in the app as dark
         themed chips with a glowing underline on the selected tab. All
         colors are DynamicResource so themes and High Contrast apply live.
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <!-- NOTE: the implicit TabItem style lives further down (search "TAB HEADERS").
         There must be exactly ONE implicit TabItem style in this dictionary — two
         entries with the same TargetType are a duplicate key and throw at load,
         which silently discards the ENTIRE stylesheet (that was the b1.3
         "nothing is themed / everything is white" bug). -->

    <!-- ═══════════════════════════════════════════════════════════════════
         HUD RING ARTWORK — bitmap shown as the radial HUD's background.
         Themes can override "HudRingImage" with a different pack URI to
         swap artwork (e.g. cyberpunk theme could ship a neon-cyan ring).
         "HudRingTintBrush" is a colored overlay that re-tints the ring
         to match the current theme palette.
         ══════════════════════════════════════════════════════════════════ -->
    <BitmapImage x:Key="HudRingImage"
                 UriSource="pack://application:,,,/Resources/Images/hud-ring.png"/>
    <!-- Center logo (Echoes Unseen dragon-and-compass). Themes can swap. -->
    <BitmapImage x:Key="EchoesUnseenLogo"
                 UriSource="pack://application:,,,/Resources/Images/echoes-unseen-logo.png"/>
    <!-- Default (Hot Pink) theme: faint pink tint to nudge the purple gems
         toward pink. Other themes set higher Opacity to recolor more
         aggressively. -->
    <SolidColorBrush x:Key="HudRingTintBrush" Color="#FFFF1A8A" Opacity="0.15"/>

    <!-- ICON GRADIENT — the blue→pink moving gradient used on HUD button icons.
         Defined here so themes can override (e.g. matrix theme = green→white).
         The gradient stops are animated in RadialHud.xaml.cs to "shimmer". -->
    <LinearGradientBrush x:Key="HudIconBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop x:Name="HudIconStop1" Color="#FF38BDF8" Offset="0.0"/>
        <GradientStop x:Name="HudIconStop2" Color="#FFFF1A8A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Brushes — initial values; ThemeService.Apply rewrites these at runtime. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FFFF1A8A"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="#FFA41435"/>
    <SolidColorBrush x:Key="BackgroundBrush"     Color="#FF0A0A0F"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#CC14141C"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush"  Color="#FFFF1A8A" Opacity="0.6"/>
    <SolidColorBrush x:Key="ForegroundBrush"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush"          Color="#FFB8B8C8"/>
    <SolidColorBrush x:Key="SuccessBrush"        Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="#FFFACC15"/>
    <SolidColorBrush x:Key="ErrorBrush"          Color="#FFEF4444"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         DARK SYSTEM CHROME — the ComboBox drop-down list is a separate top-level
         Popup whose background comes from WPF's stock Aero2 template, which uses
         SystemColors.Window (white). We can't restyle that popup without a custom
         ComboBox template (which broke selection on this overlay), so instead we
         override the SYSTEM colour keys app-wide to dark values. This turns the
         white frame around the dropdown items dark WITHOUT touching the template,
         so selection keeps working AND the list reads dark. This app is all-dark,
         so darkening system defaults is always on-theme.
         ══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#FF1E1E28</Color>
    <Color x:Key="{x:Static SystemColors.WindowTextColorKey}">#FFF2F2F7</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#FF20202A</Color>
    <Color x:Key="{x:Static SystemColors.ControlTextColorKey}">#FFF2F2F7</Color>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E1E28"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF20202A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF2F2F7"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         TYPOGRAPHY
         ══════════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">22</sys:Double>
    <sys:Double x:Key="FontSizePanelTitle">20</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════════
         PRIMARY BUTTON — Filled in the theme's primary accent, with a glow.
         Uses DynamicResource so color updates flow live when the user
         changes theme in Settings.
         ══════════════════════════════════════════════════════════════════ -->
    <!-- Filled action button. Foreground comes from OnPrimaryBrush (black or
         white, chosen from the accent's luminance) so the label stays readable
         on every theme — white-on-gold was unreadable before. A light outline
         keeps the button's edge visible against busy game backgrounds. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Roomier than it looks on paper. Quinn drives this with a pointer she
             cannot see, so every button wants to be a target she can land on rather
             than aim at: 22 by 13 with a minimum height, which is comfortably past
             the 44-pixel touch guidance once the border is counted. Set once here,
             on the style everything else inherits from, so no tab is left behind. -->
        <Setter Property="Padding" Value="22,13"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#66FFFFFF" BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource PrimaryColor}"
                                              BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary variant, in the THEME'S OWN second colour rather than a fixed
         near-black. It used to be "#E61A1A24" in every theme, so picking Ember Forge
         or Verdant recoloured everything around these and left the buttons themselves
         a row of dead grey slabs. The label colour is chosen by luminance, so a bright
         secondary reads as well as a deep one. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover and press lift off the theme colour rather than
                             jumping to a fixed grey that belongs to no theme. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryPressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         TEXTBOX — dark surface with theme-tinted focus ring
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#22222B"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         KEYBOARD FOCUS INDICATOR — high-contrast outline that follows
         keyboard navigation (Tab / Shift+Tab). Essential for screen-reader
         users (NVDA / JAWS / Narrator) who navigate with the keyboard and
         need to see which control currently has focus.
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AppFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle StrokeThickness="2"
                               Stroke="{DynamicResource PrimaryBrush}"
                               StrokeDashArray="2,1"
                               SnapsToDevicePixels="True"
                               Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply the focus visual to all controls by default. -->
    <Style TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         GLOBAL DEFAULTS — all text and controls inherit theme foreground.
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         COMBOBOX (dropdowns) — dark grey field AND dark grey popup list with
         white text. These are IMPLICIT styles (no x:Key) so every dropdown in
         every panel and popup picks them up automatically. WPF's default combo
         popup is light with black text; a full template is the only reliable
         way to recolour the drop-down list itself, not just the closed field.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════
         TAB HEADERS — the Settings tabs. The stock WPF tab headers render as
         near-white chips with faint text (hard to read and hard to tell which
         is selected). These are dark, clearly bordered, and the SELECTED tab
         fills with the theme accent so it's unmistakable by sight and to a
         screen reader. Bold, spaced text keeps them legible.
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#FFF2F2F7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="chip" Margin="2,0" Padding="14,8"
                            CornerRadius="6,6,0,0"
                            Background="#FF20202A"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1,1,1,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="chip" Property="Background" Value="#FF33333F"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#FFFFFFFF"/>
                            <Setter TargetName="chip" Property="BorderThickness" Value="2,2,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Each row in the open list. The default row Background is a SOLID dark
         colour (not Transparent) so the white item text is readable even on
         WPF's stock light popup — removing the custom ComboBox template fixed
         selection but left white-on-white; this fills every row dark. The
         highlighted row uses the theme accent so the current item is obvious. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#FFF2F2F7"/>
        <Setter Property="Background" Value="#FF241830"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="row" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#FF3A3A48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         JARVIS MIC BUTTON — animated in BOTH states so it always reads as a
         living control, with a clear colour shift between them:

           IDLE   → steel-blue core, a slow breathing steel halo (always
                    moving, so it never looks like a dead button).
           ACTIVE → bright cyan core, a faster cyan halo, and expanding
                    "sonar" rings pinging outward — unmistakably "listening".

         Idle and active use SEPARATE halo elements, each animated by exactly
         one storyboard, so their opacity animations never fight. Drive the
         state from code-behind by setting the button Tag to "active" or "idle".
         Reusable on Voice to Chat and Oracle; override Width/Height/FontSize
         locally for the smaller inline variant.
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="JarvisMic" TargetType="Button">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False">
                        <!-- ACTIVE sonar rings (invisible until active) -->
                        <Ellipse x:Name="ring1" Margin="8" Stroke="#FF00E5FF" StrokeThickness="2"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="r1" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="ring2" Margin="8" Stroke="#FF00E5FF" StrokeThickness="2"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="r2" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- IDLE halo — steel blue, always slowly breathing -->
                        <Ellipse x:Name="haloIdle" Margin="6" Fill="#FF3E7CB8" Opacity="0.25">
                            <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
                        </Ellipse>

                        <!-- ACTIVE halo — cyan, only visible while listening -->
                        <Ellipse x:Name="haloActive" Margin="4" Fill="#FF00E5FF" Opacity="0">
                            <Ellipse.Effect><BlurEffect Radius="28"/></Ellipse.Effect>
                        </Ellipse>

                        <!-- core disc — steel by default, cyan when active -->
                        <Ellipse x:Name="core" Margin="8" Fill="#FF2E5E8C"
                                 Stroke="White" StrokeThickness="3">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF1E5A9A" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Keyboard-focus ring: a bright, thick outline so the mic
                             is obvious to find and navigate to by keyboard/NVDA. -->
                        <Ellipse x:Name="focusRing" Margin="1" Stroke="#FFFFFFFF"
                                 StrokeThickness="4" StrokeDashArray="2 1.5" Opacity="0"/>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Idle breathing runs from load, forever. -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="haloIdle" Storyboard.TargetProperty="Opacity"
                                                     From="0.16" To="0.5" Duration="0:0:2.2"
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="core" Property="Opacity" Value="0.9"/>
                        </Trigger>

                        <!-- ACTIVE: cyan core + cyan halo + looping sonar pings -->
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="core" Property="Fill" Value="#FF00E5FF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="sonar">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="r1" Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.7" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="r1" Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.7" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="ring1" Storyboard.TargetProperty="Opacity"
                                                         From="0.85" To="0" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="r2" Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.7" Duration="0:0:1.6" BeginTime="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="r2" Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.7" Duration="0:0:1.6" BeginTime="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="ring2" Storyboard.TargetProperty="Opacity"
                                                         From="0.85" To="0" Duration="0:0:1.6" BeginTime="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="haloActive" Storyboard.TargetProperty="Opacity"
                                                         From="0.45" To="0.9" Duration="0:0:0.7" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="sonar"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-contrast pill button — bright white fill, black text, for the
         Piper voice Preview / Download actions so they stand out clearly. -->
    <!-- High-contrast action button (Preview / Download / Save / Reset / Change).
         DARK fill with a bright accent border and white label — readable on the
         dark UI in every theme, instead of the previous bright-white fill that
         read as a blank chip. Fills with the accent on hover/focus. -->
    <Style x:Key="HCButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Filled in the theme accent so menu buttons are COLOURFUL and
                         change with the theme (they were flat dark-grey before). The
                         accent glow makes them pop against the game behind the panel;
                         the label uses OnPrimary (auto black/white by luminance) so it
                         stays readable on gold, cyan and magenta alike. -->
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            BorderBrush="#66FFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource PrimaryColor}"
                                              BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <!-- Clearly "off": dim fill, muted label, so a disabled Preview
                             reads as unavailable rather than broken. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#FF3A3A44"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF6A6A78"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="#FF9A9AA8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CHECKBOX — big, high-contrast toggles. The stock WPF checkbox is a tiny
         13px box that a low-vision user has to magnify to hit. This makes the box
         large, the label track the global font size, and the WHOLE row a click
         target, with a clear accent fill + tick when on. Implicit style, so every
         toggle in the app (filters, feature switches, compass options) gets it.
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent padding makes the whole row an easy target. -->
                    <Border Background="Transparent" Padding="4,6" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="28" Height="28" CornerRadius="6"
                                    Background="#FF20202A" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="2">
                                <Path x:Name="tick" Stretch="Uniform" Margin="5"
                                      Data="M 0,5 L 4,9 L 11,0"
                                      Stroke="{DynamicResource OnPrimaryBrush}" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dropdown control itself.
         This template is the CANONICAL WPF ComboBox structure — a ToggleButton
         bound to IsDropDownOpen, a ContentPresenter for the selected item, and a
         Popup named PART_Popup hosting an ItemsPresenter. Because it keeps that
         exact wiring, mouse AND keyboard selection work just like the stock
         template (important for screen-reader users) — but now the CLOSED field
         is dark too. The stock Windows (Aero2) template drew the closed field
         with a light button chrome that ignored Background, which is why the
         un-opened dropdowns still looked white. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#FFF2F2F7"/>
        <Setter Property="Background" Value="#FF241830"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- The closed field. Dark, themed border. -->
                        <Border x:Name="fieldBorder" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>

                        <!-- Invisible toggle over the whole field opens/closes the list. -->
                        <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Selected item text. -->
                        <ContentPresenter x:Name="contentSite" Grid.Column="0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          IsHitTestVisible="False"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <!-- Chevron — themed accent so the field reads as interactive. -->
                        <Path Grid.Column="1" Margin="0,0,12,0"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="M0,0 L11,0 L5.5,7 Z"
                              Fill="{DynamicResource PrimaryBrush}" IsHitTestVisible="False"/>

                        <!-- The drop-down list. Dark card; rows come from the
                             ComboBoxItem style above. -->
                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                               Placement="Bottom" StaysOpen="False"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="dropDownBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0"
                                    Background="#FF241830"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="6">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fieldBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="fieldBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fieldBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
