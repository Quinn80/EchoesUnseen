<UserControl x:Class="EchoesUnseen.Views.Panels.MusicPlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="580">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Song search + selector -->
            <RowDefinition Height="Auto"/>  <!-- Current song info -->
            <RowDefinition Height="*"/>     <!-- The three tabs -->
        </Grid.RowDefinitions>

        <!-- Song selector -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SongCombo"
                      Grid.Column="0"
                      Padding="8,6"
                      DisplayMemberPath="Name"
                      SelectionChanged="SongCombo_SelectionChanged"
                      AutomationProperties.Name="Choose a song"/>
            <TextBlock x:Name="SongCount"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource GlobalFontSizeSmall}"/>
        </Grid>

        <!-- Current song info bar -->
        <Border Grid.Row="1"
                Background="#22FF1A8A"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SelectedSongName"
                               Text="(no song selected)"
                               Foreground="White" FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedSongMeta"
                               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Instrument:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SongInstrumentCombo" MinWidth="150"
                                  SelectionChanged="SongInstrument_Changed"
                                  AutomationProperties.Name="Instrument for this song">
                            <ComboBoxItem Content="Lute"/>
                            <ComboBoxItem Content="Flute"/>
                            <ComboBoxItem Content="Harp"/>
                            <ComboBoxItem Content="Horn"/>
                            <ComboBoxItem Content="Bell"/>
                            <ComboBoxItem Content="Bass Guitar"/>
                            <ComboBoxItem Content="Choir Bell"/>
                            <ComboBoxItem Content="Frame Drum"/>
                            <ComboBoxItem Content="Marriner's Horn"/>
                            <ComboBoxItem Content="Minstrel"/>
                            <ComboBoxItem Content="Piano"/>
                            <ComboBoxItem Content="Verdarach"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tempo: " Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="TempoSlider" AutomationProperties.Name="Tempo" Minimum="0.25" Maximum="2.0" Value="1.0"
                            Width="100" VerticalAlignment="Center" Margin="4,0"
                            TickFrequency="0.05"
                            ValueChanged="TempoSlider_ValueChanged"/>
                    <TextBlock x:Name="TempoLabel" Text="1.0x" Foreground="White"
                               VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The three tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}">

            <!-- Tab 1: Sheet Music -->
            <TabItem Header="📜 Sheet">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8">
                        Key mapping: C=1 · D=2 · E=3 · F=4 · G=5 · A=6 · B=7 · high C=8
                    </TextBlock>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="🔊 Read Notation"
                                Click="ReadNotation_Click"/>
                    </StackPanel>
                    <Border Grid.Row="2"
                            Background="#22222B"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SheetText"
                                       FontFamily="Consolas"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Text="(select a song)"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Guitar-Hero Guide (shows as an overlay above your skill bar) -->
            <TabItem Header="🎸 Guide">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10">
                        The guide appears as falling notes ABOVE your skill bar in-game. Equip your instrument,
                        pick Timed or Step, then Start. Notes fall on lanes 1–8; a tone sounds as each one lands.
                    </TextBlock>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Mode" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="GuideModeCombo" Grid.Column="1" SelectionChanged="GuideMode_Changed"
                                  AutomationProperties.Name="Guide mode">
                            <ComboBoxItem Content="Timed — notes fall on their own" Tag="timed"/>
                            <ComboBoxItem Content="Step — waits for you to play each note" Tag="step"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Speed" Foreground="White" VerticalAlignment="Center"
                                   ToolTip="How fast notes fall (timed mode). Higher = slower/easier."/>
                        <Slider x:Name="GuideSpeedSlider" Grid.Column="1"
                                AutomationProperties.Name="Guide note speed"
                                AutomationProperties.HelpText="How fast notes fall in timed mode. Higher is slower and easier." Minimum="700" Maximum="4000"
                                Margin="8,0" VerticalAlignment="Center" ValueChanged="GuideSpeed_Changed"/>
                        <TextBlock x:Name="GuideSpeedLabel" Grid.Column="2" Text="2.0s" Foreground="White"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Colour" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="GuideColorCombo" Grid.Column="1" SelectionChanged="GuideColor_Changed"
                                  AutomationProperties.Name="Guide note colour"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="GuideSizeSlider" Grid.Column="1"
                                AutomationProperties.Name="Guide note size" Minimum="0.6" Maximum="1.8"
                                Margin="8,0" VerticalAlignment="Center" ValueChanged="GuideSize_Changed"/>
                        <TextBlock x:Name="GuideSizeLabel" Grid.Column="2" Text="100%" Foreground="White"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="GuideTones" Content="Play a tone as each note lands" Foreground="White"
                              Margin="0,2,0,8" Checked="GuideTones_Changed" Unchecked="GuideTones_Changed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="GuideStartBtn"
                                Style="{StaticResource PrimaryButton}"
                                Content="▶ Start Guide"
                                Click="GuideStart_Click"/>
                        <Button x:Name="GuideStopBtn"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Content="⏹ Stop"
                                IsEnabled="False"
                                Click="GuideStop_Click"/>
                    </StackPanel>

                    <!-- Kept (hidden) so the legacy in-panel renderer still compiles. -->
                    <Canvas x:Name="GuideCanvas" Height="0" Visibility="Collapsed"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Auto-Play -->
            <TabItem Header="🤖 Auto-Play">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instructions banner -->
                    <Border Grid.Row="0"
                            Background="#11FACC15"
                            BorderBrush="#FFFACC15"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Foreground="White" FontWeight="SemiBold" Margin="0,0,0,2">
                                How Auto-Play works
                            </TextBlock>
                            <TextBlock Foreground="White" FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap">
                                1. Equip your instrument in GW2.
                                2. Click the GW2 window so it has focus.
                                3. Come back here and click Start — keys fire into GW2.
                                Press Stop anytime to interrupt.
                            </TextBlock>
                            <TextBlock Foreground="White" FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap" Margin="0,6,0,0">
                                Not working? If Guild Wars 2 runs as administrator, Windows blocks our
                                keypresses unless Echoes Unseen is admin too. Use the button below.
                            </TextBlock>
                            <Button x:Name="AdminBtn" Style="{StaticResource SecondaryButton}"
                                    Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Content="🛡 Run as administrator"
                                    Click="RunAsAdmin_Click"
                                    AutomationProperties.Name="Restart as administrator"
                                    AutomationProperties.HelpText="Restarts the app with administrator rights so Auto-Play keypresses can reach Guild Wars 2."/>
                        </StackPanel>
                    </Border>

                    <!-- Status line -->
                    <TextBlock Grid.Row="1"
                               x:Name="AutoStatus"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Idle."/>

                    <!-- Note progress display -->
                    <Border Grid.Row="2"
                            Background="#22222B"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="AutoNoteDisplay"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="AutoStartBtn"
                                Style="{StaticResource PrimaryButton}"
                                Content="▶ Start Auto-Play"
                                Click="AutoStart_Click"/>
                        <Button x:Name="AutoStopBtn"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Content="⏹ Stop"
                                IsEnabled="False"
                                Click="AutoStop_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="➕ Import">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Instructions banner -->
                        <Border Background="#1133CCFF"
                                BorderBrush="#FF33CCFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Foreground="White" FontWeight="SemiBold" Margin="0,0,0,2"
                                           AutomationProperties.HeadingLevel="Level2">
                                    Import a song
                                </TextBlock>
                                <TextBlock Foreground="White" FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap">
                                    Add your own sheet music. Paste it below — or load it from a file — give it a name, pick an instrument and speed, then Convert and Save. It's added to your personal library and appears in all three modes. Two formats work: number notation (1=C, 2=D, 3=E, 4=F, 5=G, 6=A, 7=B, 8=high C) and ABC letter notation (A to G). Spaces separate notes; use a dash or z for a rest.
                                </TextBlock>
                                <TextBlock Foreground="White" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                           TextWrapping="Wrap" Margin="0,8,0,0">
                                    Where to find more songs: the Guild Wars 2 Wiki page "Musical instrument" lists community song sites. Popular ones include gw2-music (gw2-music.com), the r/GuildWars2 and r/MusicBox subreddits, and Nightbloom's song archive. Most publish songs in the same 1-to-8 number notation you can paste here.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Song name" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImportName"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,10"
                                 AutomationProperties.Name="Song name"/>

                        <TextBlock Text="Instrument" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ImportInstrument"
                                  Margin="0,0,0,10" Padding="8,6"
                                  SelectedIndex="0"
                                  AutomationProperties.Name="Instrument">
                            <ComboBoxItem Content="Lute"/>
                            <ComboBoxItem Content="Flute"/>
                            <ComboBoxItem Content="Harp"/>
                            <ComboBoxItem Content="Horn"/>
                            <ComboBoxItem Content="Bell"/>
                            <ComboBoxItem Content="Bass Guitar"/>
                            <ComboBoxItem Content="Choir Bell"/>
                            <ComboBoxItem Content="Frame Drum"/>
                            <ComboBoxItem Content="Marriner's Horn"/>
                            <ComboBoxItem Content="Minstrel"/>
                            <ComboBoxItem Content="Piano"/>
                            <ComboBoxItem Content="Verdarach"/>
                        </ComboBox>

                        <TextBlock Text="Speed (BPM): higher is faster" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImportBpm"
                                 Style="{StaticResource InputBox}"
                                 Text="100"
                                 Margin="0,0,0,10"
                                 AutomationProperties.Name="Beats per minute"
                                 AutomationProperties.HelpText="A number such as 100. Higher numbers play faster."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Notes — supports chords 1/3/6, octaves [6 7 8], runs (3 2 1)" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" Padding="8,2"
                                    Content="📂 Load from file…"
                                    Click="ImportFromFile_Click"
                                    AutomationProperties.Name="Load song notes from a text file"
                                    AutomationProperties.HelpText="Open one AutoHotkey, MIDI, text or ABC file and put its notes into the box below."/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Padding="8,2"
                                    Content="📁 Import many…"
                                    Click="ImportMany_Click"
                                    AutomationProperties.Name="Import many song files at once"
                                    AutomationProperties.HelpText="Select a whole folder's worth of AutoHotkey or MIDI files and add them all to your library in one go."/>
                        </StackPanel>
                        <TextBox x:Name="ImportNotes"
                                 Style="{StaticResource InputBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"
                                 AutomationProperties.Name="Song notes"
                                 AutomationProperties.HelpText="Paste number notation like 1 2 3 4 5, or ABC letters like C D E F G. Full community notation works too: 1/3/6 is a chord, [6 7 8] is a lower octave, (3 2 1) is a rapid run, and ~ is a pause — so songs from the GW2 Wiki song lists or the Music Box 'manual' export keep their depth."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="💾 Convert &amp; Save"
                                    Click="ImportSave_Click"
                                    AutomationProperties.Name="Convert and save song"
                                    AutomationProperties.HelpText="Converts the notes and saves the song to your personal library."/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Content="🗑 Clear"
                                    Click="ImportClear_Click"
                                    AutomationProperties.Name="Clear the import form"/>
                        </StackPanel>

                        <TextBlock x:Name="ImportStatus"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Waiting for a song to import."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ FIND SONGS (search a public GW2 song library and add them) ═══ -->
            <TabItem Header="🔎 Find Songs">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Foreground="{DynamicResource MutedBrush}"
                               FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Search a public library of community GW2 songs (from the GW2 Wiki) and add the ones you like straight to your library — chords and octaves included."/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FindBox" Grid.Column="0" Padding="10,8"
                                 KeyDown="FindBox_KeyDown"
                                 AutomationProperties.Name="Search songs by name"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                Content="🔎 Search" Click="FindSearch_Click"
                                AutomationProperties.Name="Search the song library"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#22222B" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox x:Name="FindResults" Background="Transparent" BorderThickness="0"
                                 FontSize="{DynamicResource FontSizeLarge}"
                                 AutomationProperties.Name="Search results"/>
                    </Border>

                    <Button Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}"
                            Content="➕ Add selected to my library" Click="FindAdd_Click"
                            AutomationProperties.Name="Add the selected song to my library"/>

                    <TextBlock Grid.Row="4" x:Name="FindStatus" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Type a song name and press Search (or leave blank to list them all)."/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
