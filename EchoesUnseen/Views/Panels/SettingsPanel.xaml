<UserControl x:Class="EchoesUnseen.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="560" d:DesignWidth="560">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                Foreground="{DynamicResource ForegroundBrush}">

        <!-- ═══ VOICE TAB ═════════════════════════════════════════════════ -->
        <TabItem Header="Voice">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <!-- Voice ENGINE — chosen first, on its own. Kept separate
                         from the voice list so picking a voice can never
                         silently switch engines (which once dropped the app onto
                         the robotic Windows voice without the user noticing). -->
                    <TextBlock Text="Voice engine" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="EngineCombo" Margin="0,0,0,12" Padding="8,6"
                              SelectionChanged="EngineCombo_SelectionChanged"
                              AutomationProperties.Name="Voice engine"
                              AutomationProperties.HelpText="Choose which text-to-speech engine to use. Piper is a natural local voice, ElevenLabs is cloud, Windows Speech is the robotic built-in fallback.">
                        <ComboBoxItem Content="Piper — natural, local (recommended)" Tag="piper"/>
                        <ComboBoxItem x:Name="ElevenLabsEngineItem"
                                      Content="ElevenLabs — cloud, needs API key" Tag="elevenlabs"/>
                        <ComboBoxItem Content="Windows Speech — robotic, built-in" Tag="sapi"/>
                    </ComboBox>

                    <!-- Voice, scoped to the chosen engine. -->
                    <TextBlock Text="Voice" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VoiceCombo" Margin="0,0,0,12" Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectionChanged="VoiceCombo_SelectionChanged"
                              AutomationProperties.Name="Voice"
                              AutomationProperties.HelpText="Pick a voice for the selected engine."/>

                    <!-- Piper voice manager: download + preview, shown only when
                         Piper is the engine. Rows are built in code-behind. -->
                    <StackPanel x:Name="PiperManager">
                        <TextBlock Text="Piper voices — preview or download more"
                                   FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock Text="A bright check means the voice is already downloaded. Downloaded voices can be previewed; others can be downloaded first. Everything stays on this PC."
                                   FontSize="{DynamicResource GlobalFontSizeSmall}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel x:Name="PiperVoiceList"/>
                    </StackPanel>

                    <TextBlock Text="Speed" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SpeedSlider" Grid.Column="0"
                                Minimum="0.5" Maximum="2.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="False"
                                ValueChanged="SpeedSlider_ValueChanged"/>
                        <TextBlock x:Name="SpeedValue" Grid.Column="1"
                                   Text="1.0x" Margin="12,0,0,0" MinWidth="40"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Volume" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Grid.Column="0"
                                Minimum="0" Maximum="1.0" Value="1.0"
                                TickFrequency="0.05"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValue" Grid.Column="1"
                                   Text="100%" Margin="12,0,0,0" MinWidth="40"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="🔊 Test Voice" HorizontalAlignment="Left"
                            Click="TestVoice_Click" Margin="0,8,0,0"/>

                    <TextBlock x:Name="VoiceStatus"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <!-- ═══ Speech to Text (dictation) ═══════════════════════ -->
                    <Border Margin="0,20,0,0" Padding="0,16,0,0"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Speech to Text (dictation)"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Text="Choose how Voice to Chat and the Oracle turn your speech into text. Both run fully on this PC — nothing is ever sent to a server."/>

                            <ComboBox x:Name="SttEngineCombo" Margin="0,0,0,4" Padding="8,6"
                                      AutomationProperties.Name="Speech to text engine"
                                      SelectionChanged="SttEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Windows Speech (built-in, no AI — Default)" Tag="windows"/>
                                <ComboBoxItem Content="Whisper (local AI, far more accurate)" Tag="whisper"/>
                            </ComboBox>

                            <!-- Whisper-only options; shown when Whisper is selected. -->
                            <StackPanel x:Name="WhisperOptions" Visibility="Collapsed">
                                <TextBlock Text="Whisper model" FontWeight="SemiBold"
                                           Margin="0,8,0,4"/>
                                <ComboBox x:Name="WhisperModelCombo" Margin="0,0,0,4" Padding="8,6"
                                          AutomationProperties.Name="Whisper model size"
                                          SelectionChanged="WhisperModelCombo_SelectionChanged">
                                    <ComboBoxItem Content="Tiny — fastest, least accurate (75 MB)" Tag="tiny.en"/>
                                    <ComboBoxItem Content="Base — recommended balance (140 MB)" Tag="base.en"/>
                                    <ComboBoxItem Content="Small — most accurate, slower (470 MB)" Tag="small.en"/>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="The model downloads once, the first time you use it. Whisper is a local, inference-only AI: it transcribes your microphone and never receives any game data. This choice is documented on the website and in the app docs."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ API KEYS TAB ═══════════════════════════════════════════════ -->
        <TabItem Header="API Keys">
            <StackPanel Margin="8">
                <TextBlock Text="Guild Wars 2 API Key" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Required scopes: account, characters, inventories, tradingpost, wallet"
                           Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="Gw2KeyBox" Style="{x:Null}"
                             Background="#22222B" Foreground="White"
                             BorderBrush="{DynamicResource SurfaceBorderBrush}"
                             BorderThickness="1" Padding="10,8"
                             PasswordChanged="Gw2KeyBox_PasswordChanged"
                             AutomationProperties.Name="Guild Wars 2 API key"
                             Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="🔑 Test Key"
                            Click="TestGw2Key_Click"
                            AutomationProperties.Name="Test Guild Wars 2 API key"
                            AutomationProperties.HelpText="Checks the key against the official API and speaks the result."/>
                    <TextBlock x:Name="Gw2KeyStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock Margin="0,0,0,16">
                    <Hyperlink NavigateUri="https://account.arena.net/applications"
                               RequestNavigate="OpenLink"
                               Foreground="{DynamicResource PrimaryBrush}">
                        Generate a new key at account.arena.net/applications
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="ElevenLabs API Key (Optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Enables premium cloud voices. Free tier: 10,000 chars/month."
                           Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ElevenLabsKeyBox" Style="{x:Null}"
                             Background="#22222B" Foreground="White"
                             BorderBrush="{DynamicResource SurfaceBorderBrush}"
                             BorderThickness="1" Padding="10,8"
                             PasswordChanged="ElevenLabsKeyBox_PasswordChanged"
                             AutomationProperties.Name="ElevenLabs API key"
                             Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="🔑 Test Key"
                            Click="TestElevenLabsKey_Click"
                            AutomationProperties.Name="Test ElevenLabs API key"
                            AutomationProperties.HelpText="Checks the key against ElevenLabs and speaks the result."/>
                    <TextBlock x:Name="ElevenKeyStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock>
                    <Hyperlink NavigateUri="https://elevenlabs.io"
                               RequestNavigate="OpenLink"
                               Foreground="{DynamicResource PrimaryBrush}">
                        Get an ElevenLabs key at elevenlabs.io
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </TabItem>

        <!-- ═══ HUD TAB ════════════════════════════════════════════════════ -->
        <TabItem Header="HUD">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ThemeCombo" Margin="0,0,0,4" Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectionChanged="ThemeCombo_SelectionChanged"/>
                    <TextBlock x:Name="ThemeDescription"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Access Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AccessModeCombo" Margin="0,0,0,16" Padding="8,6"
                              SelectionChanged="AccessModeCombo_SelectionChanged">
                        <ComboBoxItem Content="VIP Mode (Full Accessibility)" Tag="vip"/>
                        <ComboBoxItem Content="Standard Mode" Tag="standard"/>
                    </ComboBox>

                    <TextBlock Text="HUD Scale" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Slider x:Name="HudScaleSlider" Minimum="0.75" Maximum="1.5" Value="1.0"
                            TickFrequency="0.05" Margin="0,0,0,12"
                            ValueChanged="HudScaleSlider_ValueChanged"/>

                    <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Slider x:Name="FontSizeSlider" Minimum="14" Maximum="32" Value="22"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"
                            ValueChanged="FontSizeSlider_ValueChanged"/>

                    <CheckBox x:Name="HighContrastCheck" Content="High Contrast Mode"
                              Foreground="White" Margin="0,0,0,8"
                              Checked="HighContrastCheck_Changed" Unchecked="HighContrastCheck_Changed"/>

                    <CheckBox x:Name="EarconsCheck" Content="Audio cues when panels open and close"
                              Foreground="White" Margin="0,0,0,8"
                              AutomationProperties.HelpText="Plays a short rising tone when a panel opens and a falling tone when it closes."
                              Checked="EarconsCheck_Changed" Unchecked="EarconsCheck_Changed"/>

                    <CheckBox x:Name="AnnounceHudCheck" Content="Say 'HUD active' when the mouse reaches the wheel"
                              Foreground="White" Margin="0,0,0,16"
                              AutomationProperties.HelpText="Speaks a short cue whenever the cursor enters the HUD ring, so you know clicks will go to the wheel instead of the game."
                              Checked="AnnounceHudCheck_Changed" Unchecked="AnnounceHudCheck_Changed"/>

                    <!-- v21: HUD button visibility management -->
                    <TextBlock Text="HUD Buttons" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose which buttons appear on the wheel. The remaining buttons re-space themselves evenly. The Settings button cannot be hidden, and every panel always stays reachable by its hotkey (F1–F12)."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="{DynamicResource GlobalFontSizeSmall}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel x:Name="HudButtonsList"
                                Margin="0,0,0,8"
                                AutomationProperties.Name="HUD button visibility list"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Restore All Buttons"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"
                            AutomationProperties.HelpText="Shows every HUD button again."
                            Click="RestoreButtons_Click"/>

                    <Button Style="{StaticResource SecondaryButton}"
                            Content="🎯 Reset HUD Position (Ctrl+Shift+H)"
                            HorizontalAlignment="Left"
                            Click="ResetHud_Click"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ ABOUT TAB ══════════════════════════════════════════════════ -->
        <TabItem Header="About">
            <StackPanel Margin="8">
                <TextBlock Text="Echoes Unseen" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Accessibility Overlay for Guild Wars 2"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="B1.1" Margin="0,0,0,16"
                           AutomationProperties.Name="Version: B1.1"/>

                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Content="👋 Show the welcome screen again" Margin="0,0,0,16"
                        Click="ShowWelcome_Click"
                        AutomationProperties.Name="Show the welcome screen again"
                        AutomationProperties.HelpText="Reopens the starter controls card and reads it aloud."/>

                <Border Background="#11FF1A8A" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Live MumbleLink Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="MumbleStatus"
                                   Text="Initializing..."
                                   FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeSmall}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Credits" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}" TextWrapping="Wrap">
                    Piper TTS (Rhasspy) • NAudio • Windows Speech Recognition •
                    Windows.Media.Ocr • ArenaNet (Guild Wars 2 API) • gw2mb.com (music library)
                </TextBlock>
            </StackPanel>
        </TabItem>
        <!-- ═══ FEATURES TAB ══════════════════════════════════════════════ -->
        <TabItem Header="Features">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <TextBlock Text="Turn features on or off" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,12"
                               Text="Everything here is optional. Switching a feature off never removes a tool from the wheel — it just stops that behaviour happening on its own."/>
                    <StackPanel x:Name="FeatureToggles"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ KEYBINDS TAB ══════════════════════════════════════════════ -->
        <TabItem Header="Keybinds">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,10"
                               Text="These work anywhere, even while Guild Wars 2 has focus. Press Change, then press the keys you want. Use Ctrl, Shift or Alt with a letter or function key so it won't clash with the game."/>

                    <!-- Editable shortcuts (rows built in code-behind) -->
                    <StackPanel x:Name="KeybindsList"/>

                    <Button Content="↺ Reset shortcuts to defaults"
                            Style="{StaticResource HCButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,14" Click="ResetKeybinds_Click"
                            AutomationProperties.Name="Reset all shortcuts to their defaults"/>

                    <TextBlock Text="Fixed shortcuts" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <StackPanel x:Name="FixedKeybindsList"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>

        <!-- Save / Reset footer, visible on every tab -->
        <Border Grid.Row="1" Padding="12,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource MutedBrush}"/>
                <Button Content="↺ Reset to defaults" Style="{StaticResource HCButton}"
                        Margin="0,0,8,0" Click="ResetSettings_Click"
                        AutomationProperties.Name="Reset all settings to defaults"/>
                <Button Content="💾 Save" Style="{StaticResource HCButton}"
                        Click="SaveSettings_Click"
                        AutomationProperties.Name="Save settings"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
