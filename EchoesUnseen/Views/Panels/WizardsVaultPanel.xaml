<UserControl x:Class="EchoesUnseen.Views.Panels.WizardsVaultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="520" d:DesignWidth="560"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Controls -->
            <RowDefinition Height="Auto"/>  <!-- Status / balance -->
            <RowDefinition Height="*"/>     <!-- Rewards -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#22B57BFF" BorderBrush="#FFB57BFF" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🪄 Wizard's Vault" Foreground="White"
                           FontWeight="SemiBold" FontSize="16"/>
                <!-- The balance is the first thing you want on opening this, so it is
                     the biggest thing here rather than a clause in a status line. -->
                <TextBlock x:Name="BalanceText" Foreground="#FFC400"
                           FontWeight="Bold" FontSize="26" Margin="0,6,0,2"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Astral Acclaim: checking…"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           FontSize="{DynamicResource GlobalFontSizeSmall}"
                           Text="Every reward you can trade Astral Acclaim for, with its real name and price — read from Guild Wars 2 itself rather than off the screen, so the names are always spelled right."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="🔊 Read what I can afford"
                        Click="ReadAffordable_Click"
                        AutomationProperties.Name="Read out the rewards you can afford right now"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="⟳ Refresh" Click="Refresh_Click"
                        AutomationProperties.Name="Reload the Wizard's Vault rewards"/>
            </StackPanel>

            <TextBox x:Name="Filter" Style="{StaticResource InputBox}" Margin="0,8,0,0"
                     TextChanged="Filter_Changed"
                     AutomationProperties.Name="Filter rewards by name"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#0F0F16" BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Foreground="White" TextWrapping="Wrap"
                       FontSize="16" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Loading the Wizard's Vault…"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RewardList"/>
        </ScrollViewer>
    </Grid>
</UserControl>
