<UserControl x:Class="EchoesUnseen.Views.Panels.VoiceAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="560">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header note: text-only -->
            <RowDefinition Height="*"/>     <!-- Conversation -->
            <RowDefinition Height="Auto"/>  <!-- Suggestion chips -->
            <RowDefinition Height="Auto"/>  <!-- Input box -->
        </Grid.RowDefinitions>

        <!-- Banner: this panel does live Wiki search and reads the matching article aloud -->
        <Border Grid.Row="0"
                Background="#11FF1A8A"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="{DynamicResource GlobalFontSizeSmall}"
                       AutomationProperties.Name="Oracle. Search the Guild Wars 2 Wiki by typing or speaking your query. Results are read aloud.">
                Search the Guild Wars 2 Wiki by typing OR speaking. Results are fetched live from wiki.guildwars2.com and read aloud in full. Use the microphone icon to dictate.
            </TextBlock>
        </Border>

        <!-- Conversation history -->
        <Border Grid.Row="1"
                Background="#22222B"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,8">
            <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Search history and results">
                <StackPanel x:Name="HistoryPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Suggestion chips -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" x:Name="SuggestionsPanel">
            <!-- Populated in code-behind -->
        </WrapPanel>

        <!-- Input row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="MicButton"
                    Grid.Column="0"
                    Style="{StaticResource JarvisMic}"
                    Width="46" Height="46" FontSize="20"
                    Content="🎙"
                    Tag="idle"
                    Margin="0,0,8,0"
                    Click="MicButton_Click"
                    AutomationProperties.Name="Dictate search query"
                    AutomationProperties.HelpText="Click to speak your search query. Click again to stop."/>
            <TextBox x:Name="QueryBox"
                     Grid.Column="1"
                     Style="{StaticResource InputBox}"
                     KeyDown="QueryBox_KeyDown"
                     AutomationProperties.Name="Search query"
                     AutomationProperties.HelpText="Type your wiki search query, or use the microphone button to dictate it."/>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="Search"
                    Click="Search_Click"
                    AutomationProperties.Name="Search"
                    AutomationProperties.HelpText="Submit the search query."/>
            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Content="⏹"
                    ToolTip="Stop speaking"
                    Click="Stop_Click"
                    AutomationProperties.Name="Stop speaking"
                    AutomationProperties.HelpText="Interrupt the current voice readback."/>
        </Grid>
    </Grid>
</UserControl>
