<UserControl x:Class="EchoesUnseen.Views.Panels.TradingPostPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="560">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search row -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ItemSearchBox"
                     Grid.Column="0"
                     Style="{StaticResource InputBox}"
                     KeyDown="ItemSearchBox_KeyDown"/>
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="Look Up Price"
                    Click="Search_Click"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="StatusText"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="Enter the exact item ID from the wiki, or search by name."/>

        <!-- Item details card -->
        <Border Grid.Row="2"
                x:Name="DetailCard"
                Background="#22FF1A8A"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ItemName"
                           Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="ItemRarity"
                           FontSize="{DynamicResource GlobalFontSizeSmall}" Margin="0,2,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Buy (highest)" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="BuyPrice" FontWeight="Bold" Foreground="#4ADE80"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Sell (lowest)" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="SellPrice" FontWeight="Bold" Foreground="#F87171"/>
                    </StackPanel>
                </Grid>
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="0,10,0,0"
                        Content="🔊 Read Price Aloud"
                        HorizontalAlignment="Left"
                        Click="ReadPrice_Click"/>
            </StackPanel>
        </Border>

        <!-- Wallet -->
        <Border Grid.Row="3"
                Background="#22222B"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Wallet Balance" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="Gold" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="#FACC15" TextAlignment="Center"/>
                        <TextBlock Text="gold" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="Silver" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="#E0E0E0" TextAlignment="Center"/>
                        <TextBlock Text="silver" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="Copper" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="#D97706" TextAlignment="Center"/>
                        <TextBlock Text="copper" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource MutedBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}"
                        Content="🔊 Read Wallet"
                        Click="ReadWallet_Click"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
