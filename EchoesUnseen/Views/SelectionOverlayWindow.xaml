<Window x:Class="EchoesUnseen.Views.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#88000000"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown">

    <!-- The dimmed backdrop catches mouse events; the selection rectangle
         is drawn on top with a bright pink border. -->
    <Canvas x:Name="OverlayCanvas"
            Background="#88000000"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

        <!-- Instructions, shown until user starts dragging -->
        <Border x:Name="Instructions"
                Canvas.Left="0" Canvas.Top="0"
                Background="#DD1A1A22"
                BorderBrush="#FFFF1A8A"
                BorderThickness="2"
                CornerRadius="10"
                Padding="20,14"
                Margin="0">
            <StackPanel>
                <TextBlock Foreground="#FFFF1A8A"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,4">Select a region</TextBlock>
                <TextBlock Foreground="White" FontSize="13">
                    Click and drag to select the area you want to capture.
                </TextBlock>
                <TextBlock Foreground="#B8B8C8" FontSize="11" Margin="0,4,0,0">
                    Press Escape to cancel.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- The user's selection rectangle (shown while dragging) -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FFFF1A8A"
                   StrokeThickness="2"
                   Fill="#33FF1A8A"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>
