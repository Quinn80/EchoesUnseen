<UserControl x:Class="EchoesUnseen.Views.GuideOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             HorizontalAlignment="Center" VerticalAlignment="Bottom"
             Margin="0,0,0,150">
    <!-- Guitar-Hero guide, auto-anchored above the GW2 skill bar. Not interactive;
         clicks pass through to the game. Notes fall down 8 lanes to a hit-line. -->
    <Border x:Name="Root" Background="#C0000000" CornerRadius="10" Padding="8,6"
            Visibility="Collapsed" BorderThickness="1" BorderBrush="#40FFFFFF">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="#FFF2F2F7" FontWeight="SemiBold"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Canvas x:Name="NoteCanvas" ClipToBounds="True"/>
        </StackPanel>
    </Border>
</UserControl>
